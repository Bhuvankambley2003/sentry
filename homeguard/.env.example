# HomeGuard Environment Configuration
# Copy to .env and adjust values

# API Gateway
HOMEGUARD_API_HOST=127.0.0.1
HOMEGUARD_API_PORT=8000
HOMEGUARD_TOKEN_FILE=~/.homeguard/token

# Service ports
HOMEGUARD_SCANNER_PORT=8001
HOMEGUARD_DISCOVERY_PORT=8002
HOMEGUARD_IDENTITY_PORT=8003
HOMEGUARD_TRUST_PORT=8004
HOMEGUARD_NOTIFIER_PORT=8005
HOMEGUARD_INVENTORY_PORT=8006

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# Database (~ expands at runtime)
DATABASE_URL=sqlite+aiosqlite:///${HOME}/.homeguard/homeguard.db

# Scanner settings
SCAN_INTERVAL_SECONDS=120
PORT_PROBE_ENABLED=true
PORT_PROBE_TIMEOUT_MS=500
PORT_PROBE_CONCURRENCY=10

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
